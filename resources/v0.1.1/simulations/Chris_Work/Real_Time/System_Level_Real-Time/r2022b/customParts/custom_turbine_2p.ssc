component custom_turbine_2p
% HP Turbine (2P) - Layer 2
% R2022b custom two-phase turbine
%
% This version:
%   - Uses the validated pressure-dependent flow relation
%   - Conserves mass
%   - Extracts energy using a pressure-ratio-based model
%   - Applies a user-defined turbine efficiency
%   - Reports turbine power and specific enthalpy drop
%
% Pressure-ratio energy model:
%
%   rp = pB/pA
%
%   dh_ideal =
%       dh_ref * (1-rp)/(1-rp_nom)
%
%   dh_actual = eta_t * dh_ideal
%
%   hB = hA - dh_actual
%
%   Wdot = mdot * dh_actual
%
% The turbine does not impose an enthalpy drop when there is no
% forward flow.

nodes
    A = foundation.two_phase_fluid.two_phase_fluid; 
    B = foundation.two_phase_fluid.two_phase_fluid;
end

outputs
    power_out = {0, 'kW'};
    enthalpy_drop_out = {0, 'kJ/kg'};
end

parameters

    % =========================================================
    % MASS-FLOW CHARACTERISTICS
    % =========================================================

    pA_nom = {3.5, 'MPa'};           % Nominal inlet pressure
    pB_nom = {1.0, 'MPa'};           % Nominal outlet pressure
    mdot_nom = {1.5, 'kg/s'};        % Nominal mass flow rate
    vA_nom = {0.085, 'm^3/kg'};      % Nominal inlet specific volume

    dp_min = {1, 'kPa'};              % Minimum forward pressure difference


    % =========================================================
    % TURBINE ENERGY EXTRACTION
    % =========================================================

    turbine_efficiency = {0.75, '1'};

    % Reference ideal enthalpy drop at the nominal pressure ratio
    reference_enthalpy_drop = {500, 'kJ/kg'};

end


% =============================================================
% SOLVER VARIABLES
% =============================================================

variables (Access = protected)

    mdot_A = {0, 'kg/s'};
    mdot_B = {0, 'kg/s'};

    Phi_A = {0, 'kW'};
    Phi_B = {0, 'kW'};

    % Inlet internal energy
    u_A = {1500, 'kJ/kg'};

end


% =============================================================
% BRANCHES
% =============================================================

branches

    mdot_A : A.mdot -> *;
    mdot_B : B.mdot -> *;

    Phi_A : A.Phi -> *;
    Phi_B : B.Phi -> *;

end


% =============================================================
% INTERNAL ENERGY CONVECTION COMPONENTS
% =============================================================

components (ExternalAccess = none)

    convection_A = foundation.two_phase_fluid.port_convection( ...
        flow_area = {0.01, 'm^2'}, ...
        length_scale = sqrt(4*{0.01, 'm^2'}/pi));

    convection_B = foundation.two_phase_fluid.port_convection( ...
        flow_area = {0.01, 'm^2'}, ...
        length_scale = sqrt(4*{0.01, 'm^2'}/pi));

end


% =============================================================
% INTERMEDIATE CALCULATIONS
% =============================================================

intermediates (Access = private, ExternalAccess = none)

    % ---------------------------------------------------------
    % PORT PRESSURES
    % ---------------------------------------------------------

    p_A = A.p;
    p_B = B.p;


    % ---------------------------------------------------------
    % INLET INTERNAL ENERGY
    % ---------------------------------------------------------

    u_A_port = A.u;


    % ---------------------------------------------------------
    % NORMALIZED INLET INTERNAL ENERGY
    % ---------------------------------------------------------

    unorm_A = foundation.two_phase_fluid.normalized_internal_energy( ...
        u_A_port, ...
        p_A, ...
        A.u_min, ...
        A.u_max, ...
        A.p_TLU, ...
        A.u_sat_liq_TLU, ...
        A.u_sat_vap_TLU);


    % ---------------------------------------------------------
    % INLET SPECIFIC VOLUME
    % ---------------------------------------------------------

    v_A = tablelookup( ...
        A.unorm_TLU, ...
        A.p_TLU, ...
        A.v_TLU, ...
        unorm_A, ...
        p_A, ...
        interpolation = linear, ...
        extrapolation = linear);


    % ---------------------------------------------------------
    % INLET SPECIFIC ENTHALPY
    % ---------------------------------------------------------

    h_A = u_A_port + p_A*v_A;


    % ---------------------------------------------------------
    % FORWARD PRESSURE DIFFERENCE
    % ---------------------------------------------------------

    Dp = p_A - p_B;


    % ---------------------------------------------------------
    % PRESSURE RATIO
    %
    % Current outlet pressure / current inlet pressure
    % ---------------------------------------------------------

    pressure_ratio_raw = p_B/p_A;

    pressure_ratio_calc = simscape.function.limit( ...
        pressure_ratio_raw, ...
        0, ...
        1, ...
        false);


    % ---------------------------------------------------------
    % NOMINAL PRESSURE RATIO
    % ---------------------------------------------------------

    reference_pressure_ratio_calc = ...
        pB_nom/pA_nom;


    % ---------------------------------------------------------
    % IDEAL ENTHALPY DROP
    % ---------------------------------------------------------

    ideal_enthalpy_drop_calc = ...
        reference_enthalpy_drop * ...
        (1 - pressure_ratio_calc) / ...
        (1 - reference_pressure_ratio_calc);


    % ---------------------------------------------------------
    % EFFICIENCY-CORRECTED ENTHALPY DROP
    % ---------------------------------------------------------

    actual_enthalpy_drop_calc = ...
        turbine_efficiency * ideal_enthalpy_drop_calc;


    % ---------------------------------------------------------
    % APPLY ENERGY EXTRACTION ONLY DURING FORWARD FLOW
    % ---------------------------------------------------------

 enthalpy_drop_active = {0, 'kJ/kg'};

    % ---------------------------------------------------------
    % OUTLET TOTAL SPECIFIC ENTHALPY
    % ---------------------------------------------------------

    h_B_target = h_A - enthalpy_drop_active;


    % ---------------------------------------------------------
    % TURBINE POWER
    % ---------------------------------------------------------

    turbine_power_calc = ...
        abs(mdot_A) * enthalpy_drop_active;

end


% =============================================================
% CONNECTIONS
% =============================================================

connections

    connect(A, convection_A.port);
    connect(B, convection_B.port);

end


% =============================================================
% EQUATIONS
% =============================================================

equations

    % ---------------------------------------------------------
    % Internal inlet-energy variable tied to physical port
    % ---------------------------------------------------------

    u_A == A.u;


    % ---------------------------------------------------------
    % VALIDATED PRESSURE-DEPENDENT MASS-FLOW RELATION
    % ---------------------------------------------------------

    if Dp > dp_min

        mdot_A == mdot_nom * sqrt( ...
            (p_A^2 - p_B^2) / ...
            (pA_nom^2 - pB_nom^2));

    else

        mdot_A == {0, 'kg/s'};

    end


    % ---------------------------------------------------------
    % MASS CONSERVATION
    % ---------------------------------------------------------

    mdot_A + mdot_B == 0;


    % ---------------------------------------------------------
    % ENERGY CONVECTION
    % ---------------------------------------------------------

    convection_A.mdot == mdot_A;
    convection_A.Phi == Phi_A;

    convection_B.mdot == mdot_B;
    convection_B.Phi == Phi_B;


    % ---------------------------------------------------------
    % TURBINE ENERGY EXTRACTION
    %
    % Inlet enthalpy enters at A.
    % Outlet enthalpy is reduced by the calculated turbine drop.
    % ---------------------------------------------------------

    convection_A.ht_I == h_A;
    convection_B.ht_I == h_B_target;


    % ---------------------------------------------------------
    % DIAGNOSTIC OUTPUTS
    % ---------------------------------------------------------

    power_out == turbine_power_calc;

    enthalpy_drop_out == enthalpy_drop_active;

end

end