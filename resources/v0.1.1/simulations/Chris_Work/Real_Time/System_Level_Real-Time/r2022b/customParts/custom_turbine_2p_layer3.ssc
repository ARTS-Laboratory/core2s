component custom_turbine_2p_layer3
% =============================================================
% 2P TURBINE - LAYER 3
% VARIABLE-AREA NOZZLE / PROPERTY-BASED TURBINE
%
% R2022b
%
% This version preserves the validated thermodynamic structure
% of the previous property-based turbine while replacing the
% previous empirical nozzle admission relationship with a
% variable-area compressible nozzle model.
%
%
% MAJOR FEATURES
%
%   1) Inlet state obtained from P-u:
%
%          P_A, u_A
%              |
%              +--> v_A
%              +--> h_A
%              +--> s_A
%
%   2) External nozzle command:
%
%          0 <= nozzle_command <= 1
%
%      controls physical throat area:
%
%          A_t = nozzle_command * A_t_max
%
%   3) Compressible nozzle flow model:
%
%          unchoked flow
%              OR
%          choked flow
%
%      depending on outlet/inlet pressure ratio.
%
%   4) Isentropic turbine expansion:
%
%          s_2s = s_A
%
%          P_2s = P_B
%
%      followed by turbine efficiency.
%
%   5) Actual shaft power:
%
%          Wdot = mdot * (h_A - h_B)
%
%   6) Zero-flow/neutral behavior:
%
%          mdot = 0
%          dh   = 0
%          Wdot = 0
%          h_B  = h_A
%
%
% IMPORTANT MODELING NOTE
%
%   The nozzle flow equation uses an equivalent compressible
%   vapor model with user-defined R and gamma. The present
%   turbine outlet thermodynamics remain based on the native
%   two-phase property tables.
%
% =============================================================


nodes

    A = foundation.two_phase_fluid.two_phase_fluid;
    B = foundation.two_phase_fluid.two_phase_fluid;

end


% =============================================================
% EXTERNAL INPUTS
% =============================================================

inputs

    % ---------------------------------------------------------
    % Variable nozzle command
    %
    % 0 = closed
    % 1 = fully open
    % ---------------------------------------------------------

    nozzle_command = {1, '1'};

end


% =============================================================
% OUTPUTS
% =============================================================

outputs

    power_out = {0, 'kW'};

    enthalpy_drop_out = {0, 'kJ/kg'};

    ideal_outlet_quality = {0, '1'};

    ideal_outlet_enthalpy = {0, 'kJ/kg'};

    inlet_entropy = {0, 'kJ/(kg*K)'};

    efficiency_out = {0, '1'};

    nozzle_opening_out = {0, '1'};

    nozzle_area_out = {0, 'm^2'};

    mass_flow_out = {0, 'kg/s'};

    inlet_temperature_out = {0, 'K'};

end


% =============================================================
% PARAMETERS
% =============================================================

parameters

    % =========================================================
    % NOMINAL TURBINE CONDITIONS
    % =========================================================

    pA_nom = {3.5, 'MPa'};

    pB_nom = {1.0, 'MPa'};

    mdot_nom = {1.5, 'kg/s'};


    % =========================================================
    % MINIMUM FORWARD PRESSURE DIFFERENCE
    % =========================================================

    dp_min = {1, 'kPa'};


    % =========================================================
    % VARIABLE NOZZLE
    % =========================================================
    %
    % Maximum effective throat area at 100% command.
    %
    % This should initially be chosen from the plant operating
    % point and then tuned against measured mass flow.
    %
    % =========================================================

    nozzle_area_max = {2.0e-4, 'm^2'};


    % =========================================================
    % NOZZLE DISCHARGE COEFFICIENT
    % =========================================================

    nozzle_Cd = {0.85, '1'};


    % =========================================================
    % EQUIVALENT VAPOR PROPERTIES FOR NOZZLE MODEL
    %
    % These are used only by the compressible nozzle-flow
    % approximation.
    %
    % Water-vapor specific gas constant:
    %
    %     R = 0.4615 kJ/(kg*K)
    %
    % converted here to J/(kg*K).
    % =========================================================

    vapor_R = {461.5, 'J/(kg*K)'};

    vapor_gamma = {1.30, '1'};


    % =========================================================
    % OFF-DESIGN TURBINE EFFICIENCY MAP
    %
    % This is retained from Layer 2 for now.
    %
    % Later, this can be replaced with a stage/turbine map.
    % =========================================================

    eta_peak = {0.80, '1'};

    mdot_ratio_peak = {0.80, '1'};

    efficiency_curve = {0.20, '1'};

end


% =============================================================
% VARIABLES
% =============================================================

variables (Access = protected)

    % ---------------------------------------------------------
    % THROUGH VARIABLES
    % ---------------------------------------------------------

    mdot_A = {0, 'kg/s'};

    mdot_B = {0, 'kg/s'};

    Phi_A = {0, 'kW'};

    Phi_B = {0, 'kW'};


    % ---------------------------------------------------------
    % INLET INTERNAL ENERGY
    % ---------------------------------------------------------

    u_A = {1500, 'kJ/kg'};

end


% =============================================================
% BRANCHES
% =============================================================

branches

    mdot_A : A.mdot -> *;

    mdot_B : B.mdot -> *;

    Phi_A : A.Phi -> *;

    Phi_B : B.Phi -> *;

end


% =============================================================
% INTERNAL COMPONENTS
% =============================================================

components (ExternalAccess = none)

    convection_A = foundation.two_phase_fluid.port_convection( ...
        flow_area = {0.01, 'm^2'}, ...
        length_scale = sqrt(4*{0.01, 'm^2'}/pi));


    convection_B = foundation.two_phase_fluid.port_convection( ...
        flow_area = {0.01, 'm^2'}, ...
        length_scale = sqrt(4*{0.01, 'm^2'}/pi));

end


% =============================================================
% INTERMEDIATES
% =============================================================

intermediates (Access = private, ExternalAccess = none)


    % =========================================================
    % PORT PRESSURES
    % =========================================================

    p_A = A.p;

    p_B = B.p;


    % =========================================================
    % INLET INTERNAL ENERGY
    % =========================================================

    u_A_port = A.u;


    % =========================================================
    % INLET NORMALIZED INTERNAL ENERGY
    % =========================================================

    unorm_A = ...
        foundation.two_phase_fluid.normalized_internal_energy( ...
            u_A_port, ...
            p_A, ...
            A.u_min, ...
            A.u_max, ...
            A.p_TLU, ...
            A.u_sat_liq_TLU, ...
            A.u_sat_vap_TLU);


    % =========================================================
    % INLET SPECIFIC VOLUME
    % =========================================================

    v_A = tablelookup( ...
        A.unorm_TLU, ...
        A.p_TLU, ...
        A.v_TLU, ...
        unorm_A, ...
        p_A, ...
        interpolation = linear, ...
        extrapolation = linear);


    % =========================================================
    % INLET DENSITY
    % =========================================================

    rho_A = 1/v_A;


    % =========================================================
    % INLET ENTHALPY
    % =========================================================

    h_A = ...
        u_A_port + p_A*v_A;


    % =========================================================
    % INLET ENTROPY
    % =========================================================

    s_A = tablelookup( ...
        A.unorm_TLU, ...
        A.p_TLU, ...
        A.s_TLU, ...
        unorm_A, ...
        p_A, ...
        interpolation = linear, ...
        extrapolation = linear);


    % =========================================================
    % INLET TEMPERATURE
    %
    % Temperature is obtained from the native 2P property table.
    % =========================================================

    T_A = tablelookup( ...
        A.unorm_TLU, ...
        A.p_TLU, ...
        A.T_TLU, ...
        unorm_A, ...
        p_A, ...
        interpolation = linear, ...
        extrapolation = linear);


    % =========================================================
    % FORWARD PRESSURE DIFFERENCE
    % =========================================================

    Dp = p_A - p_B;


    % =========================================================
    % NOZZLE COMMAND LIMIT
    % =========================================================

    nozzle_opening = ...
        simscape.function.limit( ...
            nozzle_command, ...
            0, ...
            1, ...
            false);


    % =========================================================
    % EFFECTIVE NOZZLE THROAT AREA
    % =========================================================

    nozzle_area = ...
        nozzle_opening * nozzle_area_max;


    % =========================================================
    % PRESSURE RATIO
    %
    % pB / pA
    %
    % This is protected against nonphysical trial states.
    % =========================================================

    pressure_ratio_raw = ...
        p_B/p_A;

    pressure_ratio = ...
        simscape.function.limit( ...
            pressure_ratio_raw, ...
            0, ...
            1, ...
            false);


    % =========================================================
    % CRITICAL PRESSURE RATIO FOR CHOKING
    % =========================================================

    critical_pressure_ratio = ...
        (2/(vapor_gamma + 1))^( ...
        vapor_gamma/(vapor_gamma - 1));


    % =========================================================
    % CHOKED NOZZLE MASS FLOW
    %
    % mdot_choked =
    %
    % Cd*A*P0/sqrt(R*T0)
    
    % sqrt(gamma)
    
    % (2/(gamma+1))^((gamma+1)/(2(gamma-1)))
    %
    % Pressure is converted from Pa-equivalent through the
    % supplied Simscape units automatically.
    % =========================================================

    choked_mass_flux = ...
        nozzle_Cd * ...
        p_A / sqrt(vapor_R*T_A) * ...
        sqrt(vapor_gamma) * ...
        (2/(vapor_gamma + 1))^( ...
        (vapor_gamma + 1)/(2*(vapor_gamma - 1)));


    mdot_choked = ...
        nozzle_area * choked_mass_flux;


    % =========================================================
    % UNCHOKED NOZZLE MASS FLOW
    %
    % Standard compressible nozzle relation.
    % =========================================================

    unchoked_flow_term_raw = ...
        (2*vapor_gamma/(vapor_gamma - 1)) * ...
        (pressure_ratio^(2/vapor_gamma) - ...
        pressure_ratio^((vapor_gamma + 1)/vapor_gamma));


    % Prevent negative trial values from reaching sqrt().
    unchoked_flow_term = ...
        simscape.function.limit( ...
            unchoked_flow_term_raw, ...
            0, ...
            1e6, ...
            false);


    mdot_unchoked = ...
        nozzle_area * ...
        nozzle_Cd * ...
        p_A / sqrt(vapor_R*T_A) * ...
        sqrt(unchoked_flow_term);


    % =========================================================
    % NOZZLE MASS-FLOW SELECTION
    %
    % If pressure ratio is below critical:
    %
    %       choked flow
    %
    % Otherwise:
    %
    %       unchoked flow
    % =========================================================

    mdot_nozzle = ...
        if lt(pressure_ratio, critical_pressure_ratio), ...
            mdot_choked ...
        else ...
            mdot_unchoked ...
        end;


    % =========================================================
    % TRANSITION-SAFE FORWARD FLOW
    % =========================================================

    mdot_forward = ...
        if gt(Dp, dp_min), ...
            mdot_nozzle ...
        else ...
            {0, 'kg/s'} ...
        end;


    % =========================================================
    % MASS FLOW RATIO
    % =========================================================

    mass_flow_ratio = ...
        abs(mdot_forward)/mdot_nom;


    % =========================================================
    % OFF-DESIGN EFFICIENCY
    % =========================================================

    efficiency_raw = ...
        eta_peak - ...
        efficiency_curve * ...
        (mass_flow_ratio - mdot_ratio_peak)^2;


    actual_efficiency = ...
        simscape.function.limit( ...
            efficiency_raw, ...
            0, ...
            1, ...
            false);


    % =========================================================
    % SATURATED OUTLET PROPERTIES
    %
    % These remain from the validated Layer 2 model.
    % =========================================================


    % ---------------------------------------------------------
    % Saturated liquid internal energy
    % ---------------------------------------------------------

    u_f_B = tablelookup( ...
        A.p_TLU, ...
        A.u_sat_liq_TLU, ...
        p_B, ...
        interpolation = linear, ...
        extrapolation = linear);


    % ---------------------------------------------------------
    % Saturated vapor internal energy
    % ---------------------------------------------------------

    u_g_B = tablelookup( ...
        A.p_TLU, ...
        A.u_sat_vap_TLU, ...
        p_B, ...
        interpolation = linear, ...
        extrapolation = linear);


    % =========================================================
    % NORMALIZED SATURATED STATES
    % =========================================================

    unorm_f_B = ...
        foundation.two_phase_fluid.normalized_internal_energy( ...
            u_f_B, ...
            p_B, ...
            A.u_min, ...
            A.u_max, ...
            A.p_TLU, ...
            A.u_sat_liq_TLU, ...
            A.u_sat_vap_TLU);


    unorm_g_B = ...
        foundation.two_phase_fluid.normalized_internal_energy( ...
            u_g_B, ...
            p_B, ...
            A.u_min, ...
            A.u_max, ...
            A.p_TLU, ...
            A.u_sat_liq_TLU, ...
            A.u_sat_vap_TLU);


    % =========================================================
    % SATURATED ENTROPIES
    % =========================================================

    s_f_B = tablelookup( ...
        A.unorm_TLU, ...
        A.p_TLU, ...
        A.s_TLU, ...
        unorm_f_B, ...
        p_B, ...
        interpolation = linear, ...
        extrapolation = linear);


    s_g_B = tablelookup( ...
        A.unorm_TLU, ...
        A.p_TLU, ...
        A.s_TLU, ...
        unorm_g_B, ...
        p_B, ...
        interpolation = linear, ...
        extrapolation = linear);


    % =========================================================
    % SATURATED SPECIFIC VOLUMES
    % =========================================================

    v_f_B = tablelookup( ...
        A.unorm_TLU, ...
        A.p_TLU, ...
        A.v_TLU, ...
        unorm_f_B, ...
        p_B, ...
        interpolation = linear, ...
        extrapolation = linear);


    v_g_B = tablelookup( ...
        A.unorm_TLU, ...
        A.p_TLU, ...
        A.v_TLU, ...
        unorm_g_B, ...
        p_B, ...
        interpolation = linear, ...
        extrapolation = linear);


    % =========================================================
    % SATURATED ENTHALPIES
    % =========================================================

    h_f_B = ...
        u_f_B + p_B*v_f_B;


    h_g_B = ...
        u_g_B + p_B*v_g_B;


    % =========================================================
    % IDEAL ISENTROPIC OUTLET QUALITY
    % =========================================================

    quality_2s_raw = ...
        (s_A - s_f_B) / ...
        (s_g_B - s_f_B);


    quality_2s = ...
        simscape.function.limit( ...
            quality_2s_raw, ...
            0, ...
            1, ...
            false);


    % =========================================================
    % IDEAL ISENTROPIC OUTLET ENTHALPY
    % =========================================================

    h_B_isentropic = ...
        h_f_B + ...
        quality_2s * ...
        (h_g_B - h_f_B);


    % =========================================================
    % IDEAL ENTHALPY DROP
    % =========================================================

    ideal_enthalpy_drop = ...
        h_A - h_B_isentropic;


    % =========================================================
    % ACTUAL ENTHALPY DROP
    % =========================================================

    actual_enthalpy_drop = ...
        actual_efficiency * ...
        ideal_enthalpy_drop;


    % =========================================================
    % TRANSITION-SAFE ENTHALPY DROP
    % =========================================================

    enthalpy_drop_active = ...
        if gt(Dp, dp_min), ...
            actual_enthalpy_drop ...
        else ...
            {0, 'kJ/kg'} ...
        end;


    % =========================================================
    % ACTUAL OUTLET ENTHALPY
    % =========================================================

    h_B = ...
        h_A - enthalpy_drop_active;


    % =========================================================
    % TURBINE POWER
    % =========================================================

    turbine_power = ...
        abs(mdot_A) * enthalpy_drop_active;

end


% =============================================================
% INTERNAL PHYSICAL CONNECTIONS
% =============================================================

connections

    connect(A, convection_A.port);

    connect(B, convection_B.port);

end


% =============================================================
% GOVERNING EQUATIONS
% =============================================================

equations


    % =========================================================
    % INLET INTERNAL ENERGY
    % =========================================================

    u_A == A.u;


    % =========================================================
    % MASS FLOW
    % =========================================================

    mdot_A == mdot_forward;


    % =========================================================
    % MASS CONSERVATION
    % =========================================================

    mdot_A + mdot_B == 0;


    % =========================================================
    % ENERGY CONVECTION
    % =========================================================

    convection_A.mdot == mdot_A;

    convection_A.Phi == Phi_A;


    convection_B.mdot == mdot_B;

    convection_B.Phi == Phi_B;


    % =========================================================
    % TURBINE ENTHALPY
    % =========================================================

    convection_A.ht_I == h_A;

    convection_B.ht_I == h_B;


    % =========================================================
    % OUTPUTS
    % =========================================================

    power_out == turbine_power;

    enthalpy_drop_out == enthalpy_drop_active;

    ideal_outlet_quality == quality_2s;

    ideal_outlet_enthalpy == h_B_isentropic;

    inlet_entropy == s_A;

    efficiency_out == actual_efficiency;

    nozzle_opening_out == nozzle_opening;

    nozzle_area_out == nozzle_area;

    mass_flow_out == mdot_A;

    inlet_temperature_out == T_A;

end


% =============================================================
% ANNOTATIONS
%
% Keeping the fluid ports on the LEFT and the external nozzle
% control on TOP.
%
% Diagnostic outputs are placed on the BOTTOM to preserve the
% visual arrangement you've been using.
% =============================================================

annotations

    A: Side = left;

    B: Side = left;

    nozzle_command: Side = top;

    power_out: Side = bottom;

    enthalpy_drop_out: Side = bottom;

    ideal_outlet_quality: Side = bottom;

    ideal_outlet_enthalpy: Side = bottom;

    inlet_entropy: Side = bottom;

    efficiency_out: Side = bottom;

    mass_flow_out: Side = bottom;

    nozzle_opening_out: Side = bottom;

    nozzle_area_out: Side = bottom;

    inlet_temperature_out: Side = bottom;

end


end